{
  "name": "citelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "chunks": "node --import tsx scripts/build-chunks.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fetch:wiki": "node --import tsx scripts/fetch-wiki.ts",
    "eval": "node --import tsx scripts/eval-retrieval.ts",
    "vectors": "node --import tsx scripts/build-vectors.ts",
    "sweep": "node --import tsx scripts/sweep-chunking.ts",
    "diag": "node --import tsx scripts/diag.ts",
    "ask": "node --env-file-if-exists=.env --import tsx scripts/ask.ts",
    "calibrate": "node --import tsx scripts/calibrate-refusal.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.247",
    "@huggingface/transformers": "^4.2.0",
    "zod": "^4.4.3"
  }
}
